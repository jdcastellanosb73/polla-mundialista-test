# Environment variables required to host the app (copy to .env and fill in).
# .NET reads double-underscore keys as nested configuration sections.

# PostgreSQL connection (any managed Postgres: Neon, Azure Flexible Server, RDS...)
ConnectionStrings__Default=Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require

# JWT signing key — generate a strong random value (48+ bytes). NEVER use the dev key in production.
Jwt__Key=<strong-random-secret>
Jwt__Issuer=polla-api
Jwt__Audience=polla-web

# Seeded accounts created on first boot (share these as the demo credentials)
Seed__AdminEmail=admin@polla.dev
Seed__AdminPassword=<admin-password>
Seed__DemoEmail=user@polla.dev
Seed__DemoPassword=<demo-password>

# CORS: allowed frontend origin(s), comma-separated
WebOrigin=https://<your-frontend-domain>

# Frontend build-time variable (configure in the frontend host)
VITE_API_URL=https://<your-api-domain>
